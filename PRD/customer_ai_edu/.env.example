ENV=dev

DATABASE_URL=postgresql+psycopg://customer_service:customer_service@192.168.168.100:5432/edu_ai_service
CUSTOMER_SERVICE_URL=http://127.0.0.1:8000
CUSTOMER_SERVICE_TIMEOUT_SECONDS=20
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# 七牛云 OpenAI 兼容网关（密钥不要提交到仓库）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://api.qnaigc.com/v1
MAIN_MODEL=deepseek/deepseek-v4-pro
FAST_MODEL=qwen/qwen3.7-flash
VISION_MODEL=qwen2.5-vl-72b-instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0
LLM_THINKING_ENABLED=false

# Agent 行为
AGENT_NAME=学习机售后智能客服
MAX_TOOL_CALLS=8
MAX_CORRECTION_ATTEMPTS=2
HISTORY_MESSAGE_LIMIT=20
HISTORY_CHARACTER_BUDGET=6000

MILVUS_URI=http://192.168.168.100:19530
MILVUS_HEALTH_URL=http://192.168.168.100:9091/healthz
MILVUS_COLLECTION=edu_cs_knowledge_v1
EMBEDDING_MODEL_PATH=C:/data/python_data/langchain/assets/models/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.30
