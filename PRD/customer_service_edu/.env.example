# 复制为 .env 后按实际环境修改；不要提交 .env
ENV=dev
DATABASE_URL=postgresql+psycopg://customer_service:customer_service@192.168.168.100:5432/edu_customer_service
REDIS_URL=redis://192.168.168.100:6379/0
AI_SERVICE_URL=http://127.0.0.1:8002
AI_TIMEOUT_SECONDS=90
DEMO_AUTH_ENABLED=true

# 内部服务认证（两服务必须一致；生产环境必须替换为随机长字符串）
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token-change-me
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=604800

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CONVERSATION_IDLE_MINUTES=120
MERGE_DELAY_MS=800
MAX_MERGE_DELAY_MS=2000
WORKER_POLL_MS=100
TURN_LEASE_SECONDS=120
MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=2
HISTORY_LIMIT=20
OUTBOX_POLL_SECONDS=1.0
OUTBOX_MAX_ATTEMPTS=5
HANDOFF_SLA_SECONDS=120
