# 复制为 deploy/.env 后修改；不要提交真实密钥
ENV=dev

CS_DATABASE_URL=postgresql+psycopg://customer_service:customer_service@192.168.168.100:5432/edu_customer_service
AI_DATABASE_URL=postgresql+psycopg://customer_service:customer_service@192.168.168.100:5432/edu_ai_service
REDIS_URL=redis://192.168.168.100:6379/0

# 两个服务必须一致
INTERNAL_SERVICE_TOKEN=change-me-internal-token
JWT_SECRET=change-me-jwt-secret

CORS_ORIGINS=http://localhost:5173

# 七牛云 OpenAI 兼容网关
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://api.qnaigc.com/v1
MAIN_MODEL=deepseek/deepseek-v4-pro
FAST_MODEL=qwen/qwen3.7-flash
VISION_MODEL=qwen2.5-vl-72b-instruct

MILVUS_URI=http://192.168.168.100:19530
MILVUS_HEALTH_URL=http://192.168.168.100:9091/healthz
MILVUS_COLLECTION=edu_cs_knowledge_v1

# bge-m3 放在宿主机该目录；INSTALL_EMBEDDING=true 时镜像才装 sentence-transformers
EMBEDDING_HOST_DIR=/opt/models/bge-m3
INSTALL_EMBEDDING=false
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
